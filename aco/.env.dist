# Adobe Developer Console > project > OAuth Server-to-Server credential
# (API: "Adobe Commerce Optimizer Ingestion", profile: "Default - Cloud Manager")
CLIENT_ID=my-client-id
CLIENT_SECRET=my-client-secret

# From the Commerce Optimizer catalog endpoint in Commerce Cloud Manager:
# https://{REGION}-{ENVIRONMENT}.api.commerce.adobe.com/{TENANT_ID}/v1/catalog
TENANT_ID=my-tenant-id
# na1 | eu1 | uk1 | au1 | in1 | sg1 | jp1
REGION=na1
# sandbox | production
ENVIRONMENT=sandbox
